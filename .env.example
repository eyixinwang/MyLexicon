# Public OAuth client ID for your own Google Cloud project. Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
# Set to /REPOSITORY_NAME/ when deploying as a GitHub Pages project site.
VITE_BASE_PATH=/
# Optional private key for LOCAL development only. Never prefix this with VITE_.
# Hosted/static builds use the per-device Gemini key entered in Settings.
GEMINI_API_KEY=
